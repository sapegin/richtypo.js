{
  "name": "richtypo",
  "license": "MIT",
  "description": "HTML and Markdown typography enhancer with extensible rules",
  "engines": {
    "node": ">=22"
  },
  "author": {
    "name": "Artem Sapegin",
    "url": "https://sapegin.me/"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/sapegin/richtypo.js.git"
  },
  "bugs": {
    "url": "https://github.com/sapegin/richtypo.js/issues"
  },
  "type": "module",
  "main": "dist/richtypo.js",
  "types": "dist/richtypo.d.ts",
  "exports": {
    ".": {
      "import": "./dist/richtypo.js"
    },
    "./rules/common": "./dist/rules/common.js",
    "./rules/en": "./dist/rules/en.js",
    "./rules/ru": "./dist/rules/ru.js",
    "./rules/fr": "./dist/rules/fr.js"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "typography",
    "typo",
    "html",
    "markdown",
    "quotes",
    "prepositions",
    "abbr",
    "abbreviations",
    "nobr",
    "nbsp",
    "punctuation",
    "em-dash",
    "ampersands",
    "space"
  ],
  "devDependencies": {
    "@types/node": "^20.8.3",
    "@vitest/coverage-v8": "^2.1.1",
    "eslint": "^9.10.0",
    "eslint-config-tamia": "^9.9.1",
    "gh-pages": "^6.0.0",
    "glob": "^10.4.2",
    "husky": "^9.1.6",
    "nano-staged": "1.0.2",
    "prettier": "^3.8.3",
    "richtypo": "file:.",
    "tsx": "^4.21.0",
    "typescript": "^5.5.2",
    "vitest": "^2.1.1"
  },
  "scripts": {
    "pretest": "npm run lint && npm run typecheck",
    "test": "vitest run",
    "posttest": "npm run format",
    "test:watch": "vitest watch",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint . --cache --fix",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"**/*.{js,cjs,mjs,ts,tsx,md,css,html}\"",
    "gh-pages": "gh-pages -d example/dist",
    "compile": "tsc --project tsconfig.build.json",
    "docs": "tsx example/src",
    "prepare": "npm run compile"
  },
  "nano-staged": {
    "*.{js,cjs,mjs,ts,tsx,md,css,html,json}": "prettier --write",
    "*.{js,cjs,mjs,ts,tsx}": "eslint --cache --fix"
  }
}
